# ============================================
# Ingest API (workers)
# ============================================

# Ingest API base URL (no trailing slash). Default when unset:
# https://irancrypto.market/api/ingest
# Override for staging or self-hosted Next.js, e.g.:
# INGEST_URL=https://staging.example.com/api/ingest
# Legacy site-root URLs still work ( /api/ingest is appended automatically ).
# INGEST_URL=

# Shared secret for Authorization: Bearer … (required; must match Next.js INGEST_SECRET)
# Generate a long random value (32+ bytes). Never commit the real secret.
INGEST_SECRET=

# Optional node identity recorded in ingest ledger + local logs
# Example: vps-1 / liara-php / home-py / irancrypto-lambda
# On AWS Lambda, defaults to the function name when unset.
INGEST_NODE=

# Optional CLI override for AWS Lambda handler (track.handler)
# TRACK_ARGS=--all --finalize

# ============================================
# Local logs
# ============================================

# Directory for JSONL run logs (default: ./logs next to the track file)
# On AWS Lambda, defaults to /tmp/irancrypto-logs when unset.
# LOG_DIR=

# Delete log files older than this many days (default: 7)
LOG_RETENTION_DAYS=7

# ============================================
# Exchange selection
# ============================================

# Comma-separated allow-list (empty = all from /api/ingest/config)
# EXCHANGES=nobitex,bitpin

# Comma-separated deny-list
IGNORE_EXCHANGES=

# ============================================
# Proxy (Tabdeal etc.)
# ============================================

PROXY_URL=
PROXY_API_KEY=

# ============================================
# Request tuning (per HTTP call to exchanges / ingest)
# ============================================

TIMEOUT=10
# PHP only: app-level time budget in seconds (0 = unlimited; PHP max_execution_time is also disabled)
# SCRIPT_MAX_SEC=0
REQUEST_RETRY_COUNT=0
REQUEST_RETRY_BASE_MS=300
USER_AGENT=

# Exchange scrape TLS (many Iranian APIs have bad certs). Default: false
SSL_VERIFY_EXCHANGE=false

# Ingest API TLS — keep true in production
SSL_VERIFY_INGEST=true

# ============================================
# External API keys (optional scrapers)
# ============================================

COINAPI_KEY=
COINMARKETCAP_API_KEY=

NODE_ENV=production
