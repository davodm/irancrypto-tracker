# ============================================
# MongoDB Configuration
# ============================================

# MongoDB connection URI
# Required: Yes
# Example: mongodb://localhost:27017 or mongodb+srv://user:password@cluster.mongodb.net
MONGO_URI=

# MongoDB database name
# Required: Yes
# Example: irancrypto_tracker
MONGO_DBNAME=

# ============================================
# Proxy Configuration (Optional)
# ============================================

# Proxy server URL for bypassing CORS or making requests through a proxy
# Required: No (only if you need to use proxy for requests)
# Example: https://your-proxy-server.com/api/proxy
PROXY_URL=

# API key for the proxy server
# Required: No (only required if PROXY_URL is set)
# Example: your-proxy-api-key-here
PROXY_API_KEY=

# ============================================
# Request Configuration (Optional)
# ============================================

# Request timeout in seconds
# Required: No (default: 10 seconds)
# Example: 30
TIMEOUT=10

# Number of retries for HTTP requests (not including the first attempt).
# If set to 0 or left empty, requests will not be retried. Set to a positive integer to enable retries.
# Example: 2
REQUEST_RETRY_COUNT=0

# Base delay in milliseconds used for exponential backoff between retries.
# Required: No (default: 300)
# Example: 300
REQUEST_RETRY_BASE_MS=300

# User agent string for HTTP requests
# Required: No (has default value)
# Example: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
USER_AGENT=

# ============================================
# External API Keys (Optional)
# ============================================

# CoinAPI API key
# Required: No (only needed if using the CoinAPI scrapper)
# Get your key from: https://www.coinapi.io/
# Example: your-coinapi-key-here
COINAPI_KEY=

# CoinMarketCap API key(s)
# Required: No (only needed if using the CoinMarketCap scrapper)
# Get your key from: https://coinmarketcap.com/api/
# You can provide multiple keys separated by commas for rate limit handling
# Example: key1,key2,key3
COINMARKETCAP_API_KEY=

# ============================================
# Error Tracking (Optional)
# ============================================

# Sentry DSN for error tracking and monitoring
# Required: No (only needed if you want error tracking)
# Get your DSN from: https://sentry.io/
# Example: https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_DSN=

# ============================================
# Application Configuration (Optional)
# ============================================

# Node.js environment
# Required: No (default: development)
# Options: development, production, test
# Example: production
NODE_ENV=development

# Cron job schedule for automated scraping
# Required: No (default: "1 * * * *" - runs every hour at minute 1)
# Format: minute hour day month day-of-week
# Examples:
#   "1 * * * *"     - Every hour at minute 1
#   "*/30 * * * *"  - Every 30 minutes
#   "0 0 * * *"     - Every day at midnight
#   "0 */2 * * *"   - Every 2 hours
CRONJOB_SCHEDULE=1 * * * *

# Comma-separated list of exchange slugs to ignore during scraping.
# Example: IGNORE_EXCHANGES=nobitex,bitmax
# If empty, no exchanges will be ignored.
IGNORE_EXCHANGES=

# When set to "true", the process will exit with a non-zero code on error (useful for
# host schedulers that expect a non-zero exit code on failure). Default: false
RUN_ONCE=false
