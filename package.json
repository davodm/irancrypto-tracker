{
  "name": "irancrypto-runner",
  "version": "0.2.6",
  "license": "AGPL-3.0-or-later",
  "description": "IranCrypto.market API-only exchange collectors (JS/PHP/Python single-file workers)",
  "main": "runtime/js/entry.js",
  "type": "module",
  "author": {
    "name": "Davod Mozafari",
    "email": "i@davod.me"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check:parity": "node scripts/check-parity.mjs",
    "check:fixtures": "node scripts/check-parse-fixtures.mjs",
    "generate": "node scripts/generate-registry.mjs",
    "build": "node scripts/build-all.mjs",
    "build:js": "node scripts/generate-registry.mjs && node scripts/build-js.mjs",
    "build:php": "node scripts/generate-registry.mjs && node scripts/build-php.mjs",
    "build:python": "node scripts/generate-registry.mjs && node scripts/build-python.mjs",
    "track": "node dist/track.cjs",
    "start": "node dist/track.cjs --all --finalize",
    "dev": "node scripts/generate-registry.mjs && node --import dotenv/config runtime/js/entry.js --all --dry-run",
    "lambda:package": "bash scripts/lambda-package.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
